  <!-- JavaScript Application Logic -->
  <script>
    // --- 1. Audio Engine (Natural Camera Shutter SFX) ---
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playShutterSound() {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      
      const now = audioCtx.currentTime;
      // White noise buffer for physical snap & mirror click
      const bufferSize = audioCtx.sampleRate * 0.12;
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = Math.random() * 2 - 1;
      }

      const noise = audioCtx.createBufferSource();
      noise.buffer = buffer;

      const filter = audioCtx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.setValueAtTime(1400, now);
      filter.Q.setValueAtTime(1.5, now);

      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.9, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);

      noise.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);

      noise.start(now);
      noise.stop(now + 0.12);

      // Low mechanical thud
      const osc = audioCtx.createOscillator();
      const oscGain = audioCtx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(120, now);
      osc.frequency.exponentialRampToValueAtTime(30, now + 0.08);

      oscGain.gain.setValueAtTime(0.6, now);
      oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);

      osc.connect(oscGain);
      oscGain.connect(audioCtx.destination);

      osc.start(now);
      osc.stop(now + 0.08);
    }

    function playBeepSound(high = false) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(high ? 880 : 440, now);
      gain.gain.setValueAtTime(0.2, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.15);
    }

    // --- 2. Filters Configuration ---
    const FILTERS = [
      { id: 'normal', name: 'Normal', css: '' },
      { id: 'y2k', name: 'Y2K Pink', css: 'sepia(0.3) saturate(1.8) hue-rotate(310deg) brightness(1.1)' },
      { id: 'cyber', name: 'Cyber Glyph', css: 'contrast(1.4) saturate(2) hue-rotate(180deg) brightness(0.9)' },
      { id: 'webcore', name: 'Webcore', css: 'contrast(1.2) saturate(1.6) hue-rotate(270deg) brightness(1.05)' },
      { id: 'analog', name: 'Analog Film', css: 'sepia(0.25) contrast(1.15) brightness(0.95) saturate(1.1)' },
      { id: 'contrast', name: 'Punchy B&W', css: 'grayscale(1) contrast(1.8) brightness(1.05)' },
      { id: 'vintage', name: 'Vintage Warm', css: 'sepia(0.5) contrast(1.1) brightness(0.9) saturate(1.2)' },
      { id: 'neon', name: 'Cyber Neon', css: 'saturate(2.2) contrast(1.3) hue-rotate(290deg)' },
      { id: 'pastel', name: 'Soft Pastel', css: 'brightness(1.15) saturate(0.8) contrast(0.95)' },
      { id: 'sepia', name: 'Retro Sepia', css: 'sepia(0.9) contrast(1.2)' },
      { id: 'bw', name: 'B&W Classic', css: 'grayscale(1) contrast(1.2)' },
      { id: 'dreamy', name: 'Dreamy Bloom', css: 'blur(0.5px) brightness(1.2) saturate(1.3) contrast(0.9)' },
      { id: 'noir', name: 'Noir Cinema', css: 'grayscale(1) contrast(1.6) brightness(0.8)' }
    ];

    let currentFilter = '';
    const filterListEl = document.getElementById('filter-list');
    FILTERS.forEach(f => {
      const btn = document.createElement('button');
      btn.className = `px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition border-2 ${f.id === 'normal' ? 'bg-pink-500 text-white border-pink-500' : 'bg-pink-50 text-pink-600 border-pink-200 hover:bg-pink-100'}`;
      btn.textContent = f.name;
      btn.onclick = () => {
        document.querySelectorAll('#filter-list button').forEach(b => {
          b.className = 'px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition border-2 bg-pink-50 text-pink-600 border-pink-200 hover:bg-pink-100';
        });
        btn.className = 'px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition border-2 bg-pink-500 text-white border-pink-500';
        currentFilter = f.css;
        webcam.style.filter = currentFilter;
      };
      filterListEl.appendChild(btn);
    });

    // --- 3. Webcam Initialization & Switching ---
    const webcam = document.getElementById('webcam');
    let currentFacingMode = 'user';
    let capturedPhotos = [];

    async function initCamera() {
      try {
        if (window.localStream) {
          window.localStream.getTracks().forEach(t => t.stop());
        }
        const constraints = {
          video: { facingMode: currentFacingMode, width: { ideal: 1280 }, height: { ideal: 720 } },
          audio: false
        };
        const stream = await navigator.mediaDevices.getUserMedia(constraints);
        window.localStream = stream;
        webcam.srcObject = stream;
        await webcam.play();
      } catch (err) {
        console.warn('Advanced camera failed, falling back to basic:', err);
        try {
          const fallbackStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
          window.localStream = fallbackStream;
          webcam.srcObject = fallbackStream;
          await webcam.play();
        } catch (e) {
          alert('Tidak dapat mengakses kamera. Pastikan izin kamera aktif atau gunakan tombol upload.');
        }
      }
    }
    initCamera();

    document.getElementById('switch-cam-btn').onclick = () => {
      currentFacingMode = currentFacingMode === 'user' ? 'environment' : 'user';
      initCamera();
    };

    // --- 4. Capture & Countdown Logic ---
    const captureCanvas = document.getElementById('capture-canvas');
    const ctx = captureCanvas.getContext('2d');

    function takeSnapshot() {
      captureCanvas.width = webcam.videoWidth || 640;
      captureCanvas.height = webcam.videoHeight || 480;
      ctx.save();
      if (currentFacingMode === 'user') {
        ctx.scale(-1, 1);
        ctx.drawImage(webcam, -captureCanvas.width, 0, captureCanvas.width, captureCanvas.height);
      } else {
        ctx.drawImage(webcam, 0, 0, captureCanvas.width, captureCanvas.height);
      }
      ctx.restore();

      // Apply filter to snapshot if active
      if (currentFilter) {
        const imgData = ctx.getImageData(0, 0, captureCanvas.width, captureCanvas.height);
        ctx.filter = currentFilter;
        ctx.drawImage(captureCanvas, 0, 0);
        ctx.filter = 'none';
      }

      return captureCanvas.toDataURL('image/png');
    }

    async function runCountdown(seconds) {
      const overlay = document.getElementById('countdown-overlay');
      const numEl = document.getElementById('countdown-number');
      overlay.classList.remove('hidden');

      for (let i = seconds; i > 0; i--) {
        numEl.textContent = i;
        playBeepSound(i === 1);
        await new Promise(r => setTimeout(r, 1000));
      }
      overlay.classList.add('hidden');
    }

    document.getElementById('capture-btn').onclick = async () => {
      const mode = document.getElementById('mode-select').value;
      const timer = parseInt(document.getElementById('timer-select').value);

      if (mode === 'single') {
        await runCountdown(timer);
        playShutterSound();
        capturedPhotos = [takeSnapshot()];
        updatePreview();
      } else {
        // Burst 4 photos
        capturedPhotos = [];
        for (let i = 0; i < 4; i++) {
          await runCountdown(timer);
          playShutterSound();
          capturedPhotos.push(takeSnapshot());
          if (i < 3) await new Promise(r => setTimeout(r, 800));
        }
        updatePreview();
      }
    };

    // Upload fallback handler
    document.getElementById('upload-file').onchange = (e) => {
      const files = e.target.files;
      if (!files.length) return;
      capturedPhotos = [];
      const limit = Math.min(files.length, 6);
      for (let i = 0; i < limit; i++) {
        const reader = new FileReader();
        reader.onload = (event) => {
          capturedPhotos.push(event.target.result);
          if (capturedPhotos.length === limit) updatePreview();
        };
        reader.readAsDataURL(files[i]);
      }
    };

    // --- 5. Interactive Stickers System ---
    const stickerLayer = document.getElementById('sticker-layer');
    let activeSticker = null;

    function addStickerToTray(content) {
      const el = document.createElement('div');
      el.className = 'sticker-item selected text-4xl';
      el.style.left = '50px';
      el.style.top = '50px';
      el.textContent = content;

      // Handles
      const delBtn = document.createElement('div');
      delBtn.className = 'sticker-handle handle-delete';
      delBtn.innerHTML = '✕';
      delBtn.onclick = (e) => { e.stopPropagation(); el.remove(); };

      const scaleBtn = document.createElement('div');
      scaleBtn.className = 'sticker-handle handle-scale';
      scaleBtn.innerHTML = '⤢';

      const rotBtn = document.createElement('div');
      rotBtn.className = 'sticker-handle handle-rotate';
      rotBtn.innerHTML = '↻';

      el.appendChild(delBtn);
      el.appendChild(scaleBtn);
      el.appendChild(rotBtn);

      // Drag & Interaction logic
      let isDragging = false, isScaling = false, isRotating = false;
      let startX, startY, startW = 40, startAngle = 0;

      el.onmousedown = (e) => {
        if (e.target.classList.contains('sticker-handle')) return;
        document.querySelectorAll('.sticker-item').forEach(s => s.classList.remove('selected'));
        el.classList.add('selected');
        isDragging = true;
        startX = e.clientX - el.offsetLeft;
        startY = e.clientY - el.offsetTop;
        e.stopPropagation();
      };

      window.onmousemove = (e) => {
        if (isDragging) {
          el.style.left = (e.clientX - startX) + 'px';
          el.style.top = (e.clientY - startY) + 'px';
        }
      };

      window.onmouseup = () => {
        isDragging = false; isScaling = false; isRotating = false;
      };

      stickerLayer.appendChild(el);
      stickerLayer.style.pointerEvents = 'auto';
    }

    document.querySelectorAll('.sticker-btn').forEach(btn => {
      btn.onclick = () => addStickerToTray(btn.textContent);
    });

    document.getElementById('clear-stickers').onclick = () => {
      stickerLayer.innerHTML = '';
    };

    // --- 6. Photostrip Preview & Customization Engine ---
    const layoutSelect = document.getElementById('layout-select');
    const patternSelect = document.getElementById('pattern-select');
    const colorPrimary = document.getElementById('color-primary');
    const colorSecondary = document.getElementById('color-secondary');
    const patternScale = document.getElementById('pattern-scale');
    const stripTitle = document.getElementById('strip-title');
    const fontSelect = document.getElementById('font-select');
    const textColor = document.getElementById('text-color');
    const dateToggle = document.getElementById('date-toggle');
    const slotsPreview = document.getElementById('strip-slots-preview');

    // Color combo preset buttons
    document.querySelectorAll('#color-combos button').forEach(btn => {
      btn.onclick = () => {
        colorPrimary.value = btn.dataset.c2;
        colorSecondary.value = btn.dataset.c1;
        updatePreview();
      };
    });

    function getPatternCSS() {
      const pat = patternSelect.value;
      const c1 = colorPrimary.value;
      const c2 = colorSecondary.value;
      const scale = patternScale.value;

      if (pat === 'solid') return `background-color: ${c2};`;
      if (pat === 'polka') return `background-color: ${c2}; background-image: radial-gradient(${c1} ${scale * 0.25}px, transparent ${scale * 0.25}px); background-size: ${scale}px ${scale}px;`;
      if (pat === 'grid') return `background-color: ${c2}; background-image: linear-gradient(to right, ${c1} 2px, transparent 2px), linear-gradient(to bottom, ${c1} 2px, transparent 2px); background-size: ${scale}px ${scale}px;`;
      if (pat === 'checker') return `background-color: ${c2}; background-image: linear-gradient(45deg, ${c1} 25%, transparent 25%), linear-gradient(-45deg, ${c1} 25%, transparent 25%), linear-gradient(45deg, transparent 75%, ${c1} 75%), linear-gradient(-45deg, transparent 75%, ${c1} 75%); background-size: ${scale}px ${scale}px; background-position: 0 0, 0 ${scale/2}px, ${scale/2}px -${scale/2}px, -${scale/2}px 0px;`;
      if (pat === 'stripes') return `background-color: ${c2}; background-image: repeating-linear-gradient(45deg, ${c1}, ${c1} ${scale*0.3}px, transparent ${scale*0.3}px, transparent ${scale*0.6}px);`;
      if (pat === 'hearts' || pat === 'stars') {
        return `background-color: ${c2}; background-image: radial-gradient(${c1} 30%, transparent 31%); background-size: ${scale}px ${scale}px;`;
      }
      return `background-color: ${c2};`;
    }

    function updatePreview() {
      const layout = layoutSelect.value;
      const title = stripTitle.value;
      const font = fontSelect.value;
      const tColor = textColor.value;
      const showDate = dateToggle.checked;
      const dateStr = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });

      slotsPreview.style.cssText = getPatternCSS() + '; padding: 16px; border-radius: 16px; display: flex; flex-direction: column; align-items: center; gap: 12px;';

      // Build HTML preview slots
      let html = `<div class="${font} tracking-wide text-center" style="color: ${tColor}; font-size: 16px; font-weight: bold; margin-bottom: 4px;">${title}</div>`;

      const photos = capturedPhotos.length ? capturedPhotos : [null, null, null, null];

      if (layout === '4-vertical') {
        slotsPreview.style.width = '220px';
        photos.slice(0, 4).forEach((p, i) => {
          html += `<div class="w-48 h-36 bg-slate-200 rounded-lg overflow-hidden shadow border border-white/60 flex items-center justify-center">
            ${p ? `<img src="${p}" class="w-full h-full object-cover">` : `<span class="text-xs text-slate-400 font-bold">Foto ${i+1}</span>`}
          </div>`;
        });
      } else if (layout === '2x2-grid') {
        slotsPreview.style.width = '280px';
        html += `<div class="grid grid-cols-2 gap-2 w-full px-2">`;
        photos.slice(0, 4).forEach((p, i) => {
          html += `<div class="aspect-square bg-slate-200 rounded-lg overflow-hidden shadow border border-white/60 flex items-center justify-center">
            ${p ? `<img src="${p}" class="w-full h-full object-cover">` : `<span class="text-xs text-slate-400 font-bold">Foto ${i+1}</span>`}
          </div>`;
        });
        html += `</div>`;
      } else if (layout === '3-mini') {
        slotsPreview.style.width = '200px';
        photos.slice(0, 3).forEach((p, i) => {
          html += `<div class="w-40 h-28 bg-slate-200 rounded-lg overflow-hidden shadow border border-white/60 flex items-center justify-center">
            ${p ? `<img src="${p}" class="w-full h-full object-cover">` : `<span class="text-xs text-slate-400 font-bold">Foto ${i+1}</span>`}
          </div>`;
        });
      } else if (layout === '6-collage') {
        slotsPreview.style.width = '300px';
        html += `<div class="grid grid-cols-2 gap-2 w-full px-2">`;
        (photos.length >= 6 ? photos.slice(0, 6) : [...photos, null, null, null, null, null, null]).slice(0, 6).forEach((p, i) => {
          html += `<div class="aspect-[4/3] bg-slate-200 rounded-lg overflow-hidden shadow border border-white/60 flex items-center justify-center">
            ${p ? `<img src="${p}" class="w-full h-full object-cover">` : `<span class="text-xs text-slate-400 font-bold">Foto ${i+1}</span>`}
          </div>`;
        });
        html += `</div>`;
      } else if (layout === 'wide-dual') {
        slotsPreview.style.width = '300px';
        photos.slice(0, 2).forEach((p, i) => {
          html += `<div class="w-72 h-44 bg-slate-200 rounded-lg overflow-hidden shadow border border-white/60 flex items-center justify-center">
            ${p ? `<img src="${p}" class="w-full h-full object-cover">` : `<span class="text-xs text-slate-400 font-bold">Landscape ${i+1}</span>`}
          </div>`;
        });
      } else if (layout === 'horizontal') {
        slotsPreview.style.width = '420px';
        html += `<div class="flex gap-2 overflow-x-auto w-full px-2">`;
        photos.slice(0, 4).forEach((p, i) => {
          html += `<div class="w-32 h-24 bg-slate-200 rounded-lg overflow-hidden shadow border border-white/60 flex-shrink-0 flex items-center justify-center">
            ${p ? `<img src="${p}" class="w-full h-full object-cover">` : `<span class="text-xs text-slate-400 font-bold">Foto ${i+1}</span>`}
          </div>`;
        });
        html += `</div>`;
      }

      if (showDate) {
        html += `<div class="text-[10px] font-bold tracking-wider mt-1 opacity-80" style="color: ${tColor};">${dateStr} • WhimSwag</div>`;
      }

      slotsPreview.innerHTML = html;
    }

    // Event listeners for preview updates
    layoutSelect.onchange = updatePreview;
    patternSelect.onchange = updatePreview;
    colorPrimary.oninput = updatePreview;
    colorSecondary.oninput = updatePreview;
    patternScale.oninput = updatePreview;
    stripTitle.oninput = updatePreview;
    fontSelect.onchange = updatePreview;
    textColor.oninput = updatePreview;
    dateToggle.onchange = updatePreview;

    // Initial render
    updatePreview();

    // --- 7. High-Resolution Canvas Download Engine ---
    document.getElementById('download-btn').onclick = async () => {
      if (!capturedPhotos.length) {
        alert('Silakan ambil foto terlebih dahulu!');
        return;
      }

      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      const scale = 3; // High-res multiplier
      const layout = layoutSelect.value;
      const title = stripTitle.value;
      const pat = patternSelect.value;
      const c1 = colorPrimary.value;
      const c2 = colorSecondary.value;
      const patScale = parseInt(patternScale.value) * scale;
      const tColor = textColor.value;
      const showDate = dateToggle.checked;
      const dateStr = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });

      // Dimension configs based on layout
      let width = 600, height = 900;
      if (layout === '2x2-grid') { width = 700; height = 850; }
      else if (layout === '3-mini') { width = 550; height = 750; }
      else if (layout === '6-collage') { width = 800; height = 950; }
      else if (layout === 'wide-dual') { width = 800; height = 850; }
      else if (layout === 'horizontal') { width = 950; height = 550; }

      canvas.width = width * scale;
      canvas.height = height * scale;

      // Draw Background / Pattern
      ctx.fillStyle = c2;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      if (pat === 'polka') {
        ctx.fillStyle = c1;
        const step = patScale;
        for (let x = 0; x < canvas.width; x += step) {
          for (let y = 0; y < canvas.height; y += step) {
            ctx.beginPath();
            ctx.arc(x, y, (patScale * 0.25), 0, Math.PI * 2);
            ctx.fill();
          }
        }
      } else if (pat === 'grid') {
        ctx.strokeStyle = c1;
        ctx.lineWidth = 4;
        const step = patScale;
        for (let x = 0; x < canvas.width; x += step) {
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
        }
        for (let y = 0; y < canvas.height; y += step) {
          ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
        }
      } else if (pat === 'checker') {
        ctx.fillStyle = c1;
        const step = patScale;
        let row = 0;
        for (let y = 0; y < canvas.height; y += step / 2) {
          let col = row % 2;
          for (let x = 0; x < canvas.width; x += step / 2) {
            if (col % 2 === 0) {
              ctx.fillRect(x, y, step / 2, step / 2);
            }
            col++;
          }
          row++;
        }
      } else if (pat === 'hearts') {
        ctx.fillStyle = c1;
        const step = patScale;
        for (let x = 20; x < canvas.width; x += step) {
          for (let y = 20; y < canvas.height; y += step) {
            ctx.font = `${patScale * 0.8}px sans-serif`;
            ctx.fillText('❤', x, y);
          }
        }
      } else if (pat === 'stars') {
        ctx.fillStyle = c1;
        const step = patScale;
        for (let x = 20; x < canvas.width; x += step) {
          for (let y = 20; y < canvas.height; y += step) {
            ctx.font = `${patScale * 0.8}px sans-serif`;
            ctx.fillText('★', x, y);
          }
        }
      }

      // Draw Title Header
      ctx.fillStyle = tColor;
      ctx.font = `bold ${18 * scale}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.fillText(title, canvas.width / 2, 45 * scale);

      // Helper function to load and draw photo slot
      const drawPhoto = async (dataUrl, x, y, w, h) => {
        return new Promise((resolve) => {
          const img = new Image();
          img.onload = () => {
            ctx.save();
            ctx.fillStyle = '#ffffff';
            ctx.shadowColor = 'rgba(0, 0, 0, 0.15)';
            ctx.shadowBlur = 15 * scale;
            ctx.fillRect(x - 6*scale, y - 6*scale, w + 12*scale, h + 12*scale);
            ctx.restore();
            ctx.drawImage(img, x, y, w, h);
            resolve();
          };
          img.src = dataUrl;
        });
      };

      const photos = capturedPhotos;
      const pad = 40 * scale;

      if (layout === '4-vertical') {
        const pw = 480 * scale; const ph = 360 * scale;
        const startX = (canvas.width - pw) / 2;
        let startY = 75 * scale;
        for (let i = 0; i < Math.min(photos.length, 4); i++) {
          await drawPhoto(photos[i], startX, startY, pw, ph);
          startY += ph + 25 * scale;
        }
      } else if (layout === '2x2-grid') {
        const pw = 300 * scale; const ph = 300 * scale;
        const gap = 30 * scale;
        const startX = (canvas.width - (pw * 2 + gap)) / 2;
        let startY = 75 * scale;
        for (let i = 0; i < Math.min(photos.length, 4); i++) {
          const col = i % 2;
          const row = Math.floor(i / 2);
          await drawPhoto(photos[i], startX + col * (pw + gap), startY + row * (ph + gap), pw, ph);
        }
      } else if (layout === '3-mini') {
        const pw = 420 * scale; const ph = 310 * scale;
        const startX = (canvas.width - pw) / 2;
        let startY = 75 * scale;
        for (let i = 0; i < Math.min(photos.length, 3); i++) {
          await drawPhoto(photos[i], startX, startY, pw, ph);
          startY += ph + 25 * scale;
        }
      } else if (layout === '6-collage') {
        const pw = 240 * scale; const ph = 180 * scale;
        const gap = 20 * scale;
        const pList = photos.length >= 6 ? photos : [...photos, photos[0], photos[1], photos[2]].slice(0, 6);
        const startX = (canvas.width - (pw * 3 + gap * 2)) / 2;
        let startY = 75 * scale;
        for (let i = 0; i < 6; i++) {
          const col = i % 3;
          const row = Math.floor(i / 3);
          await drawPhoto(pList[i], startX + col * (pw + gap), startY + row * (ph + gap), pw, ph);
        }
      } else if (layout === 'wide-dual') {
        const pw = 640 * scale; const ph = 360 * scale;
        const startX = (canvas.width - pw) / 2;
        let startY = 75 * scale;
        for (let i = 0; i < Math.min(photos.length, 2); i++) {
          await drawPhoto(photos[i], startX, startY, pw, ph);
          startY += ph + 30 * scale;
        }
      } else if (layout === 'horizontal') {
        const pw = 360 * scale; const ph = 270 * scale;
        const gap = 25 * scale;
        const startX = 40 * scale;
        let startY = 120 * scale;
        for (let i = 0; i < Math.min(photos.length, 4); i++) {
          await drawPhoto(photos[i], startX + i * (pw + gap), startY, pw, ph);
        }
      }

      // Draw Date Footer
      if (showDate) {
        ctx.fillStyle = tColor;
        ctx.font = `bold ${12 * scale}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.fillText(`${dateStr} • WhimSwag Photo Booth`, canvas.width / 2, canvas.height - 25 * scale);
      }

      // Trigger download
      const link = document.createElement('a');
      link.download = `WhimSwag-Photostrip-${Date.now()}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
    };

    // Share API
    document.getElementById('share-btn').onclick = async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: 'WhimSwag Photo Booth',
            text: 'Lihat photostrip seruku dari WhimSwag!',
            url: window.location.href
          });
        } catch (err) {
          console.log('Share canceled or failed', err);
        }
      } else {
        alert('Web Share API tidak didukung di browser ini. Gunakan tombol download untuk menyimpan foto!');
      }
    };
  </script>
</body>
